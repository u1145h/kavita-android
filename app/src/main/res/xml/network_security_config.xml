<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext (HTTP) traffic is allowed so the app can talk to any self-hosted
    Kavita server over the LAN, which typically runs plain HTTP. HTTPS servers
    work too.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
